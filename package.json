{
  "name": "skiracepals",
  "private": true,
  "scripts": {
    "db": "powershell -ExecutionPolicy Bypass -File scripts/start-db.ps1",
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm run test -w server"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
